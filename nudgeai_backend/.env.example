# Copy to .env and fill in. Never commit .env.

# --- app ---
ENVIRONMENT=dev
DEBUG=false
API_PREFIX=/api/v1

# --- database ---
# Local PostgreSQL 16, no Docker. Socket + peer auth needs no password:
DATABASE_URL=postgresql+psycopg://haroffcode@/nudgeai?host=/var/run/postgresql
# Or TCP with a password:
# DATABASE_URL=postgresql+psycopg://haroffcode:yourpassword@127.0.0.1:5432/nudgeai

# --- redis ---
# Local Redis 7.0.15, no modules. Cache and queue only.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 bytes for HS256. Required outside ENVIRONMENT=dev.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_CODE_TTL_MINUTES=15

# --- models (Meta) ---
# Meta Model API (Muse Spark series, Muse Voice Transcribe). Exact model IDs come
# from the Model list in the Meta docs.
META_API_KEY=
META_API_BASE_URL=
# Muse Spark Open, served on Baseten. Use the hackathon id, not the docs' one.
BASETEN_API_KEY=
BASETEN_BASE_URL=
MUSE_VOICE_MODEL=
# Embeddings: Meta's model list has no embedding model yet. Open item, see
# docs/BACKEND_PLAN.md. Leave empty to use the offline StaticEmbedder.
EMBEDDING_MODEL=
# Keep this in step with memories.embedding.
# pgvector cannot build an HNSW/IVFFlat index above
# 2000 dimensions, so 1024 is the default: Matryoshka-native and indexable.
EMBEDDING_DIM=1024
# Set false to keep full 2048-dim vectors, which means no ANN index (exact search only).
HNSW_INDEX_ENABLED=true

# --- semantic cache ---
SEMANTIC_CACHE_THRESHOLD=0.08
SEMANTIC_CACHE_TTL_DAYS=7

# --- memory retrieval ---
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.35

# --- tools ---
# Read-only Google Calendar. Keep false for the demo; a deterministic stub is used.
CALENDAR_ENABLED=false

# --- email ---
RESEND_API_KEY=

# --- phase 2: model router ---
MODEL_FAST=meta-models/muse-spark-open-1026
# MODEL_SMART / MODEL_DEEP: leave commented until Gate 2b confirms the real
# Muse Spark ids. Empty values would fail the three-distinct-tiers check, so
# the code defaults (placeholders, never called without keys) apply instead.
#MODEL_SMART=
#MODEL_DEEP=
# Hard cap on prompt assembly. A 1M context window is not a licence to fill it.
CHAT_HISTORY_MESSAGES=20
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1
MODEL_RETRY_BACKOFF_SECONDS=1.0
# Ceiling from the plan: routing must never spend a model call to decide.
PLANNER_CONTEXT_TOKENS=200000

# --- phase 2: budgets (per user, per UTC day) ---
# Reaching a ceiling pins the turn to BUDGET_DEGRADED_MODEL instead of erroring.
BUDGET_DAILY_CALLS=200
BUDGET_DAILY_TOKENS=500000
BUDGET_DEGRADED_MODEL=fast

# --- phase 2: executor ---
EXECUTOR_MAX_HOPS=4
MAX_TOOL_RESULT_CHARS=2000

# --- phase 2: observability ---
# Force the offline scripted fake even when a key is present.
FORCE_FAKE_MODELS=false
